{
  "name": "fitlook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "admin:dev": "vite --config admin/vite.config.js --host 0.0.0.0",
    "admin:build": "vite build --config admin/vite.config.js",
    "admin:preview": "vite preview --config admin/vite.config.js --host 0.0.0.0",
    "server": "node server/index.js",
    "worker": "node scripts/worker.js",
    "start:role": "node scripts/start-role.js",
    "server:watch": "nodemon server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "db:create-indexes": "node scripts/create-indexes.js",
    "storage:migrate:bunny": "node scripts/migrate-uploads-to-bunny.js",
    "storage:migrate:bunny:apply": "node scripts/migrate-uploads-to-bunny.js --apply",
    "load:backend": "k6 run tests/load/backend-load.k6.js",
    "load:backend:read": "LOAD_PROFILE=read k6 run tests/load/backend-load.k6.js",
    "load:backend:auth": "LOAD_PROFILE=auth k6 run tests/load/backend-load.k6.js",
    "load:backend:write": "LOAD_PROFILE=write k6 run tests/load/backend-load.k6.js",
    "load:aws:read": "BASE_URL=https://fitlook.in k6 run tests/load/backend-public-read.k6.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "aws": "^0.0.3-2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "heic-convert": "^2.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^6.1.0",
    "sharp": "^0.33.5",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
